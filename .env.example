# Copy this file to .env and fill in real values. Never commit .env.

# Set to "production" on real deployments. When production, the app refuses
# to start unless SECRET_KEY is also set (see config/env_check.py). Leave
# unset or "development" for local work.
APP_ENV=development

# Flask session signing key. Any long random string.
# REQUIRED when APP_ENV=production — the app will not start without it.
# Optional in development (a clearly-labeled insecure default is used).
SECRET_KEY=change-me-to-a-random-string

# NewsAPI.org API key. Used by the scraper to pull additional insurance
# articles. Optional: the RSS-based sources still work without it.
NEWS_API_KEY=

# --- LinkedIn posting (scripts/daily_linkedin_post.py) ---
# Create an app at https://developer.linkedin.com/, add the "Share on
# LinkedIn" and "Sign In with LinkedIn using OpenID Connect" products,
# then set the redirect URL to http://localhost:8914/callback.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Populated automatically by running `python scripts/linkedin_auth.py`
# after the two values above are set. Do not fill these in by hand.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=
